# Frontend (Vite) — baked into the built bundle, not secret
VITE_SERVER_NAME="Наш сервер Arma 3"

# Backend (server/) — never commit real values

# First admin account, created automatically on first boot if no admins
# exist yet. After that, manage admins from the panel itself.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie (JWT). Required in production —
# generate one with `openssl rand -hex 32` or similar.
JWT_SECRET=

# Telegram bot used to notify staff about new orders (same bot as tg-moderator,
# or a separate one — either way, read the token from here, never hardcode it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional: port the server listens on (defaults to 4000)
PORT=4000
